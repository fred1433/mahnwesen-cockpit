      "parameters": {
        "jsCode": "// Der Lauf kommt als JSON aus dem Dienst. Hier wird er nur aufgeteilt;\n// entschieden wird nichts, jede Entscheidung steht im geprueften Code.\nconst lauf = $input.first().json;\nreturn lauf.vorgaenge.map((v) => ({ json: {\n  nummer: v.entwurf.nummer,\n  stufe: v.entwurf.stufe.name,\n  betrag: v.entwurf.briefbetrag,\n  warteschlange: v.warteschlange,\n  grund: v.grund,\n  verantwortlich: v.verantwortlich,\n  naechsteAktion: v.naechsteAktion,\n  kontrollen: v.befunde.length,\n  bestanden: v.befunde.filter((b) => b.bestanden).length,\n  imPostausgang: lauf.postausgang.some((p) => p.nummer === v.entwurf.nummer),\n} }));\n"
      },
